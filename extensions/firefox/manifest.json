{
  "manifest_version": 2,
  "name": "OTTER Download Engine — Firefox Integration",
  "version": "0.1.0",
  "description": "Seamless integration between Mozilla Firefox and the high-throughput, crash-safe OTTER Rust download engine.",
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "nativeMessaging",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "otter-engine@otter.dev",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "OTTER 0.1.0 Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
